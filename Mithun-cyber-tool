        print("Invalid IPv4 address.")
        return

    print("Gateway address:", gateway)
    print("Neighbour table:")

    os.system("ip neigh")


# 6. DNS lookup
def dns_lookup():
    domain = get_domain()

    if not domain:
        return

    try:
        results = socket.getaddrinfo(domain, None)

        addresses = sorted({
            item[4][0]
            for item in results
        })

        print("\nDNS results:")

        for address in addresses:
            print("-", address)

    except socket.gaierror:
        print("DNS lookup failed.")


# 7. Website security headers
def website_security():
    domain = get_domain()

    if not domain:
        return

    try:
        response = session.get(
            "https://" + domain,
            timeout=10
        )

        print("Final URL:", response.url)
        print("HTTP status:", response.status_code)

        checks = {
            "Strict-Transport-Security": "HSTS",
            "Content-Security-Policy": "CSP",
            "X-Content-Type-Options": "Content-Type protection",
            "X-Frame-Options": "Frame protection",
            "Referrer-Policy": "Referrer policy"
        }

        for header, label in checks.items():
            if header in response.headers:
                print(
                    GREEN + "[FOUND] "
                    + label + RESET
                )
            else:
                print(
                    YELLOW + "[NOT FOUND] "
                    + label + RESET
                )

        print(
            "Missing header ante automatic "
            "ga vulnerability ani kaadu."
        )

    except requests.RequestException as e:
        print("Website request failed:", e)


