# 3. Strong password generator
def password_generator():
    try:
        length = int(input("Password length (8-128): "))

        if not 8 <= length <= 128:
            print("Length 8 to 128 madhya undali.")
            return

    except ValueError:
        print("Number enter cheyyi.")
        return

    alphabet = (
        string.ascii_letters
        + string.digits
        + "!@#$%^&*()-_=+"
    )

    password = "".join(
        secrets.choice(alphabet)
        for _ in range(length)
    )

    print(
        GREEN + "\nGenerated password:" + RESET,
        password
    )


# 4. IP information
def ip_info():
    print("1. Public IP")
    print("2. Domain IP")

    choice = input("Select: ").strip()

    try:
        if choice == "1":
            response = session.get(
                "https://api.ipify.org",
