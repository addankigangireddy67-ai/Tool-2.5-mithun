def get_domain():
    domain = input("Domain enter cheyyi: ").strip()
    domain = domain.replace("https://", "")
    domain = domain.replace("http://", "")
    domain = domain.split("/")[0].split(":")[0]

    if not domain or any(c.isspace() for c in domain):
        print(RED + "Invalid domain!" + RESET)
        return None

    return domain


# 1. Instagram public profile information
def instagram_info():
    username = input(
        "Instagram username: "
    ).strip().lstrip("@")

    if not username or any(c.isspace() for c in username):
        print("Valid username enter cheyyi.")
        return

    url = (
        "https://www.instagram.com/"
        + urllib.parse.quote(username)
        + "/"
    )

    try:
        response = session.get(url, timeout=10)

        print("HTTP status:", response.status_code)
        print("Profile URL:", url)

        if response.status_code == 200:
            print(GREEN + "Page accessible." + RESET)
        else:
            print(
                YELLOW
                + "Status does not confirm account existence."
                + RESET
            )

    except requests.RequestException as e:
        print("Request failed:", e)


