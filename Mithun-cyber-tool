# 9. Password strength checker
def password_checker():
    password = input("Demo password enter cheyyi: ")

    score = 0

    if len(password) >= 12:
        score += 1

    if any(c.islower() for c in password):
        score += 1

    if any(c.isupper() for c in password):
        score += 1

    if any(c.isdigit() for c in password):
        score += 1

    if any(not c.isalnum() for c in password):
        score += 1

    labels = [
        "Very weak",
        "Weak",
        "Fair",
        "Good",
        "Strong",
        "Very strong"
    ]

    print("Estimated strength:", labels[score])

    print(
        "Personal passwords badulu demo strings use cheyyi."
    )


